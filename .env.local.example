# Server-only Supabase PostgreSQL connection string. Use the Transaction Pooler.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres
# Server-only JWT signing secret; do not use a NEXT_PUBLIC_ prefix.
JWT_SECRET=

# Optional for local UI -> API calls. Leave unset on Vercel for same-origin /api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
